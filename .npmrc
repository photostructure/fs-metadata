# Security: Disable lifecycle scripts by default to protect against supply chain attacks.
# See: https://www.nodejs-security.com/blog/npm-ignore-scripts-best-practices-as-security-mitigation-for-malicious-packages
# Invoke required project build scripts explicitly after installation.
ignore-scripts=true

# Only resolve dependency releases that have aged for at least two weeks.
min-release-age=14

# Retry configuration for flaky CDN connections
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Log level
loglevel=warn
